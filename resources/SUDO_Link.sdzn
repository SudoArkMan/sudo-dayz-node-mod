            "y": 610,
            "inputs": {},
            "opts": {
              "code": "// fps is rounded to an int on the wire. A float here would be\n// formatted by Enforce's locale-independent-but-unspecified rules, and\n// a comma decimal separator would produce malformed JSON. The API\n// stores it as a double, so precision below 1 fps is not worth a\n// formatting risk on every heartbeat.\nstring json = \"{\";"
            }
          },
          {
            "id": "nrb",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 760,
            "inputs": {},
            "opts": {
              "code": "json += SUDO_Json.Num(\"playerCount\", playerCount);"
            }
          },
          {
            "id": "nrd",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 910,
            "inputs": {},
            "opts": {
              "code": "if (fpsKnown)\n{\n\tjson += \",\" + SUDO_Json.Num(\"fps\", Math.Round(fps));\n}"
            }
          },
          {
            "id": "nrf",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 1060,
            "inputs": {},
            "opts": {
              "code": "json += \",\" + SUDO_Json.Num(\"uptimeSeconds\", uptimeSeconds);"
            }
          },
          {
            "id": "nrh",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
