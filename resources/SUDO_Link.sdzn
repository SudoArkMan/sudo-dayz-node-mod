            "x": 300,
            "y": 19210,
            "inputs": {},
            "opts": {
              "code": "// GetGame().GetPlayer() returns null on a dedicated server. GetPlayers()\n// is the only way to enumerate, and it is what this must use.\narray<Man> players = new array<Man>();"
            }
          },
          {
            "id": "niw",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 19360,
