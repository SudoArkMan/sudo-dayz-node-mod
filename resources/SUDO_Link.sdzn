          },
          {
            "id": "nc3",
            "kind": "event",
            "ref": "fn.entry.fc2",
            "x": 40,
            "y": 5080,
            "inputs": {}
          },
          {
            "id": "nc4",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 5080,
            "inputs": {},
            "opts": {
              "code": "// A rejected key is permanent until an operator fixes it, so say so\n// plainly instead of retrying forever and filling the log.\nif (parsed.status == SUDO_Const.STATUS_AUTH_FAILED)\n{\n\tSUDO_Log.Error(\"API key rejected. Check apiKey in \" + SUDO_Const.CONFIG_PATH);\n\treturn;\n}"
            }
          },
          {
            "id": "nc6",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 5230,
            "inputs": {},
            "opts": {
              "code": "if (parsed.status == SUDO_Const.STATUS_PROTOCOL_UNSUPPORTED)\n{\n\tSUDO_Log.Error(\"This mod version is too old for the SUDO API. Update it from the Workshop.\");\n\treturn;\n}"
            }
          },
          {
            "id": "nc8",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 5380,
            "inputs": {},
            "opts": {
              "code": "if (parsed.status == SUDO_Const.STATUS_SUBSCRIPTION_INACTIVE)\n{\n\tSUDO_Log.Warn(\"Subscription inactive. The server stays online; the dashboard is read-only.\");\n\treturn;\n}"
            }
          },
          {
            "id": "nca",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 5530,
            "inputs": {},
            "opts": {
              "code": "SUDO_Log.Warn(\"Link rejected: \" + parsed.error);"
            }
          },
          {
            "id": "ncd",
            "kind": "event",
            "ref": "fn.entry.fcc",
            "x": 40,
            "y": 5800,
            "inputs": {}
          },
          {
            "id": "nce",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 5800,
            "inputs": {},
            "opts": {
              "code": "if (!m_Enabled)\n{\n\treturn;\n}"
            }
          },
          {
            "id": "ncg",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 5950,
            "inputs": {},
            "opts": {
              "code": "m_TickCount++;"
            }
          },
          {
            "id": "nci",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 6100,
            "inputs": {},
            "opts": {
              "code": "if (m_TickCount < m_BackoffUntilTick)\n{\n\treturn;\n}"
            }
          },
          {
            "id": "nck",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 6250,
            "inputs": {},
            "opts": {
              "code": "if (!m_Api.IsLinked())\n{\n\tTryLink();\n\treturn;\n}"
            }
          },
          {
            "id": "ncm",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 6400,
            "inputs": {},
            "opts": {
              "code": "if (m_TickCount % m_FlushEvery == 0)\n{\n\tFlushEvents();\n}"
            }
          },
          {
            "id": "nco",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 6550,
            "inputs": {},
            "opts": {
              "code": "if (m_TickCount % m_HeartbeatEvery == 0)\n{\n\tSendHeartbeat();\n}"
            }
          },
          {
            "id": "ncq",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 6700,
            "inputs": {},
            "opts": {
              "code": "if (m_TickCount % m_PollEvery == 0)\n{\n\tPollCommands();\n}"
            }
