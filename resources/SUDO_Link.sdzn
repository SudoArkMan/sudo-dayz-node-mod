            "x": 300,
            "y": 14200,
            "inputs": {},
            "opts": {
              "code": "SUDO_Log.Debug(\"Heartbeat failed: \" + reason);"
            }
          },
          {
            "id": "ngk",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 14350,
            "inputs": {},
            "opts": {
              "code": "ApplyBackoff();"
            }
          },
          {
            "id": "ngn",
            "kind": "event",
            "ref": "fn.entry.fgm",
            "x": 40,
            "y": 14620,
            "inputs": {}
          },
          {
            "id": "ngo",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 14620,
            "inputs": {},
            "opts": {
              "code": "m_Api.PollCommands(new SUDO_CommandsCallback(), \"{}\");"
            }
          },
          {
            "id": "ngr",
            "kind": "event",
            "ref": "fn.entry.fgq",
            "x": 40,
            "y": 14890,
            "inputs": {}
          },
          {
            "id": "ngs",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 14890,
            "inputs": {},
            "opts": {
              "code": "SUDO_CommandsResponse response = SUDO_CommandsResponse.FromJson(data);"
            }
          },
          {
            "id": "ngu",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 15040,
            "inputs": {},
            "opts": {
              "code": "if (response.status == SUDO_Const.STATUS_AUTH_FAILED)\n{\n\tm_Api.ClearSession();\n\treturn;\n}"
            }
          },
          {
            "id": "ngw",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 15190,
            "inputs": {},
            "opts": {
              "code": "if (response.pollIntervalSeconds > 0)\n{\n\tm_PollEvery = response.pollIntervalSeconds;\n}"
            }
          },
          {
            "id": "ngy",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 15340,
            "inputs": {},
            "opts": {
              "code": "m_FailureStreak = 0;"
            }
          },
          {
            "id": "nh0",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 15490,
            "inputs": {},
            "opts": {
              "code": "if (response.commands.Count() == 0)\n{\n\treturn;\n}"
            }
          },
          {
            "id": "nh2",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 15640,
            "inputs": {},
            "opts": {
              "code": "SUDO_CommandResultsRequest results = new SUDO_CommandResultsRequest();"
            }
          },
          {
            "id": "nh4",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 15790,
            "inputs": {},
            "opts": {
              "code": "foreach (SUDO_Command command : response.commands)\n{\n\t// Delivery is at-least-once, so the same command can arrive twice\n\t// if our acknowledgement was lost. Executing a ban twice is\n\t// harmless; executing a kick twice is not, so dedupe regardless.\n\tif (m_ExecutedIds.Find(command.id) != -1)\n\t{\n\t\tcontinue;\n\t}\n\n\tm_ExecutedIds.Insert(command.id);\n\n\tSUDO_CommandResult result = new SUDO_CommandResult();\n\tresult.id = command.id;\n\tresult.state = Execute(command);\n\tresults.results.Insert(result);\n}"
            }
          },
          {
            "id": "nh6",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 14890,
            "inputs": {},
            "opts": {
              "code": "// Bounded so a long-running server does not accumulate ids forever.\nwhile (m_ExecutedIds.Count() > 500)\n{\n\tm_ExecutedIds.RemoveOrdered(0);\n}"
            }
          },
          {
            "id": "nh8",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 15040,
            "inputs": {},
            "opts": {
              "code": "if (results.results.Count() > 0)\n{\n\tm_Api.PostCommandResults(new SUDO_ResultsCallback(), results.ToJson());\n}"
            }
          },
          {
            "id": "nhb",
            "kind": "event",
            "ref": "fn.entry.fha",
            "x": 40,
            "y": 15910,
            "inputs": {}
          },
          {
            "id": "nhc",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 15910,
            "inputs": {},
            "opts": {
              "code": "SUDO_Log.Debug(\"Command poll failed: \" + reason);"
            }
          },
          {
            "id": "nhe",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 16060,
            "inputs": {},
            "opts": {
              "code": "ApplyBackoff();"
            }
          },
          {
            "id": "nhh",
            "kind": "event",
            "ref": "fn.entry.fhg",
            "x": 40,
            "y": 16330,
            "inputs": {}
          },
          {
            "id": "nhi",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 16330,
            "inputs": {},
            "opts": {
              "code": "// switch falls through in Enforce Script exactly as it does in C, so\n// every case needs its break.\nswitch (command.type)\n{\n\tcase SUDO_Const.COMMAND_KICK:\n\t\treturn KickPlayer(command.steam64, command.reason);\n\n\tcase SUDO_Const.COMMAND_BAN:\n\t\treturn BanPlayer(command.steam64, command.reason);\n\n\tcase SUDO_Const.COMMAND_BROADCAST:\n\t\treturn Broadcast(command.message);\n}"
            }
          },
          {
            "id": "nhk",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 16480,
            "inputs": {},
            "opts": {
              "code": "// An older mod meeting a newer command type says so, rather than\n// reporting success for something it never did.\nSUDO_Log.Warn(\"Unsupported command type: \" + command.type);"
            }
          },
          {
            "id": "nhn",
            "kind": "builtin",
            "ref": "bi.rawExpr",
            "x": 260,
            "y": 16720,
            "inputs": {},
            "opts": {
              "code": "SUDO_Const.RESULT_UNSUPPORTED"
