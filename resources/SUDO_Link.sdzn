    {
      "id": "s6b",
      "name": "SUDO_ConfigLoader",
      "folder": "3_Game/SUDO_Link",
      "graph": {
        "className": "SUDO_ConfigLoader",
        "baseClass": "",
        "modded": false,
        "module": "3_Game",
        "nodes": [
          {
            "id": "n5s",
            "kind": "event",
            "ref": "fn.entry.f5r",
            "x": 40,
            "y": 40,
            "inputs": {}
          },
          {
            "id": "n5t",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 40,
            "inputs": {},
            "opts": {
              "code": "SUDO_Config config = new SUDO_Config();"
            }
          },
          {
            "id": "n5v",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 190,
            "inputs": {},
            "opts": {
              "code": "if (!FileExist(SUDO_Const.CONFIG_PATH))\n{\n\tSUDO_Log.Warn(\"No config found. Writing a template to \" + SUDO_Const.CONFIG_PATH);\n\tJsonFileLoader<SUDO_Config>.JsonSaveFile(SUDO_Const.CONFIG_PATH, config);\n\tSUDO_Log.Warn(\"Paste your API key from the SUDO dashboard into that file, then restart the server.\");\n\treturn config;\n}"
            }
          },
          {
            "id": "n5x",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 340,
            "inputs": {},
            "opts": {
              "code": "JsonFileLoader<SUDO_Config>.JsonLoadFile(SUDO_Const.CONFIG_PATH, config);"
            }
          },
          {
            "id": "n5z",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 490,
            "inputs": {},
            "opts": {
              "code": "config.ValidateAndExtend();"
            }
          },
          {
            "id": "n61",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 640,
            "inputs": {},
            "opts": {
              "code": "SUDO_Log.s_DebugEnabled = config.debugEnabled;"
            }
          },
          {
            "id": "n63",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 790,
            "inputs": {},
            "opts": {
              "code": "if (!config.IsConfigured())\n{\n\tSUDO_Log.Warn(\"Config exists but apiKey is empty. Edit \" + SUDO_Const.CONFIG_PATH + \" and restart.\");\n\treturn config;\n}"
            }
          },
          {
            "id": "n65",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 940,
            "inputs": {},
            "opts": {
              "code": "SUDO_Log.Info(\"Config loaded. Key \" + SUDO_Log.Redact(config.apiKey) + \" targeting \" + config.baseUrl);"
            }
          },
          {
            "id": "n68",
            "kind": "builtin",
            "ref": "bi.rawExpr",
            "x": 580,
            "y": 130,
            "inputs": {},
            "opts": {
              "code": "config"
            }
          },
          {
            "id": "n67",
            "kind": "builtin",
            "ref": "bi.return",
            "x": 620,
            "y": 40,
            "inputs": {},
            "opts": {}
          }
