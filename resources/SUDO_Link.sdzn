          },
          {
            "id": "nub",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 610,
            "inputs": {},
            "opts": {
              "code": "// BEFORE super. A mission can end and restart without the process\n// restarting, and a surviving manager would leave a second tick loop\n// running against a session that no longer exists.\nSUDO_Manager.DestroyInstance();"
            }
          },
          {
            "id": "nud",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 760,
            "inputs": {},
            "opts": {
              "code": "super.OnMissionFinish();"
            }
          },
          {
            "id": "nug",
            "kind": "event",
            "ref": "fn.entry.fuf",
            "x": 40,
            "y": 1030,
            "inputs": {}
          },
          {
            "id": "nuh",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 1030,
            "inputs": {},
            "opts": {
              "code": "super.OnUpdate(timeslice);"
            }
          },
          {
            "id": "nuj",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 1180,
            "inputs": {},
            "opts": {
              "code": "SUDO_Manager manager = SUDO_Manager.GetInstance();"
            }
          },
          {
            "id": "nul",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 1330,
            "inputs": {},
            "opts": {
              "code": "if (manager)\n{\n\tmanager.OnServerFrame(timeslice);\n}"
            }
          },
          {
            "id": "nuo",
            "kind": "event",
            "ref": "fn.entry.fun",
            "x": 40,
            "y": 1600,
            "inputs": {}
          },
          {
            "id": "nup",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 1600,
            "inputs": {},
            "opts": {
              "code": "super.InvokeOnConnect(player, identity);"
            }
          },
          {
            "id": "nur",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 1750,
            "inputs": {},
            "opts": {
              "code": "SUDO_Manager manager = SUDO_Manager.GetInstance();"
            }
          },
          {
            "id": "nut",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 1900,
            "inputs": {},
            "opts": {
              "code": "if (!manager)\n{\n\treturn;\n}"
            }
          },
          {
            "id": "nuv",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2050,
            "inputs": {},
            "opts": {
              "code": "if (!identity)\n{\n\treturn;\n}"
            }
          },
          {
            "id": "nux",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2200,
            "inputs": {},
            "opts": {
              "code": "// GetPlainId is the Steam64; GetId is the BattlEye GUID. Both are\n// recorded because the platform links identities across name changes\n// using whichever it has, and a server may report one without the other.\nmanager.QueuePlayerEvent(\n\tSUDO_Const.EVENT_PLAYER_CONNECT,\n\tidentity.GetPlainId(),\n\tidentity.GetId(),\n\tidentity.GetName());"
            }
          },
          {
            "id": "nv0",
            "kind": "event",
            "ref": "fn.entry.fuz",
            "x": 40,
            "y": 2470,
            "inputs": {}
          },
          {
            "id": "nv1",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2470,
            "inputs": {},
            "opts": {
              "code": "SUDO_Manager manager = SUDO_Manager.GetInstance();"
            }
          },
          {
            "id": "nv3",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2620,
            "inputs": {},
            "opts": {
              "code": "if (manager && player)\n{\n\tPlayerIdentity identity = player.GetIdentity();\n\n\t// Identity is read before the super call. After it the player is\n\t// being torn down and the identity may already be gone.\n\tif (identity)\n\t{\n\t\tmanager.QueuePlayerEvent(\n\t\t\tSUDO_Const.EVENT_PLAYER_DISCONNECT,\n\t\t\tidentity.GetPlainId(),\n\t\t\tidentity.GetId(),\n\t\t\tidentity.GetName());\n\t}\n}"
            }
          },
          {
            "id": "nv5",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2770,
            "inputs": {},
            "opts": {
              "code": "super.InvokeOnDisconnect(player);"
            }
          }
        ],
