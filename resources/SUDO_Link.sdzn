            "x": 300,
            "y": 11620,
            "inputs": {},
            "opts": {
              "code": "ApplyBackoff();"
            }
          },
          {
            "id": "nfj",
            "kind": "event",
            "ref": "fn.entry.ffi",
            "x": 40,
            "y": 11890,
            "inputs": {}
          },
          {
            "id": "nfk",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 11890,
            "inputs": {},
            "opts": {
              "code": "if (!m_Enabled)\n{\n\treturn;\n}"
            }
          },
          {
            "id": "nfm",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 12040,
            "inputs": {},
            "opts": {
              "code": "// A zero or negative slice would divide the window by nothing and\n// report an absurd frame rate on the next heartbeat.\nif (timeslice <= 0)\n{\n\treturn;\n}"
            }
          },
          {
            "id": "nfo",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 12190,
            "inputs": {},
            "opts": {
              "code": "m_FrameCount++;"
            }
          },
          {
            "id": "nfq",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 12340,
            "inputs": {},
            "opts": {
              "code": "m_FrameSeconds += timeslice;"
            }
          },
          {
            "id": "nft",
            "kind": "event",
            "ref": "fn.entry.ffs",
            "x": 40,
            "y": 12610,
            "inputs": {}
          },
          {
            "id": "nfu",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 12610,
            "inputs": {},
            "opts": {
              "code": "SUDO_HeartbeatRequest request = new SUDO_HeartbeatRequest();"
            }
          },
          {
            "id": "nfw",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 12760,
            "inputs": {},
            "opts": {
              "code": "request.playerCount = CountPlayers();"
            }
          },
          {
            "id": "nfy",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 12910,
            "inputs": {},
            "opts": {
              "code": "request.uptimeSeconds = UptimeSeconds();"
            }
          },
          {
            "id": "ng0",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 13060,
            "inputs": {},
            "opts": {
              "code": "// fps was hardcoded to 0 and the API stored it, so every dashboard\n// showed every server pinned at zero frames. A window with no samples\n// means the frame hook never ran, and saying nothing is the only honest\n// answer: the API models fps as nullable, so an omitted key reads as\n// \"not known\" instead of as a number.\nif (m_FrameCount > 0 && m_FrameSeconds > 0)\n{\n\tfloat frames = m_FrameCount;\n\trequest.fps = frames / m_FrameSeconds;\n\trequest.fpsKnown = true;\n}"
            }
          },
          {
            "id": "ng2",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 13210,
            "inputs": {},
            "opts": {
              "code": "m_FrameCount = 0;"
            }
          },
          {
            "id": "ng4",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 13360,
            "inputs": {},
            "opts": {
              "code": "m_FrameSeconds = 0;"
            }
          },
          {
            "id": "ng6",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 13510,
            "inputs": {},
            "opts": {
              "code": "// Measured live before this was trusted: uptimeSeconds ran 30/60/90 across\n// consecutive beats, and fps read 891/969/959 on an idle server, which is\n// the right order of magnitude for a simulation loop with no players on it.\nm_Api.PostHeartbeat(new SUDO_HeartbeatCallback(), request.ToJson());"
            }
          },
          {
            "id": "ng9",
            "kind": "event",
            "ref": "fn.entry.fg8",
            "x": 40,
            "y": 13630,
            "inputs": {}
          },
          {
            "id": "nga",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 13630,
            "inputs": {},
            "opts": {
              "code": "SUDO_SimpleResponse response = SUDO_SimpleResponse.FromJson(data);"
            }
          },
          {
            "id": "ngc",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 13780,
            "inputs": {},
            "opts": {
              "code": "if (response.status == SUDO_Const.STATUS_AUTH_FAILED)\n{\n\tm_Api.ClearSession();\n\treturn;\n}"
            }
          },
          {
            "id": "nge",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 13930,
            "inputs": {},
            "opts": {
              "code": "m_FailureStreak = 0;"
            }
          },
          {
