          {
            "id": "njg",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 20500,
            "inputs": {},
            "opts": {
              "code": "// The widening to float has to happen BEFORE the multiply, not after.\n// Ticks scaled up to milliseconds overflow a 32-bit int at roughly 25\n// days of uptime, and a long-lived persistent server would then start\n// reporting a negative one. Narrowing back on assignment truncates,\n// which vanilla relies on in areadamagelooped.c:54 and :69.\nfloat milliseconds = m_TickCount;"
            }
          },
          {
            "id": "nji",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 20650,
            "inputs": {},
            "opts": {
              "code": "milliseconds = milliseconds * SUDO_Const.TICK_INTERVAL;"
            }
          },
          {
            "id": "njk",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 20800,
            "inputs": {},
            "opts": {
              "code": "int seconds = milliseconds / 1000.0;"
            }
          },
          {
            "id": "njn",
            "kind": "builtin",
            "ref": "bi.rawExpr",
            "x": 260,
            "y": 21040,
