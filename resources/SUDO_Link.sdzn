        "nodes": [
          {
            "id": "nq7",
            "kind": "event",
            "ref": "fn.entry.fq6",
            "x": 40,
            "y": 40,
            "inputs": {}
          },
          {
            "id": "nq8",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 40,
            "inputs": {},
            "opts": {
              "code": "events = new array<ref SUDO_Event>();"
            }
          },
          {
            "id": "nqb",
            "kind": "event",
            "ref": "fn.entry.fqa",
            "x": 40,
            "y": 310,
            "inputs": {}
          },
          {
            "id": "nqc",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 310,
            "inputs": {},
            "opts": {
              "code": "string json = \"{\";"
            }
          },
          {
            "id": "nqe",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 460,
            "inputs": {},
            "opts": {
              "code": "json += SUDO_Json.Str(\"batchId\", batchId);"
            }
          },
          {
            "id": "nqg",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 610,
            "inputs": {},
            "opts": {
              "code": "json += \",\" + SUDO_Json.Num(\"droppedSinceLastBatch\", droppedSinceLastBatch);"
            }
          },
          {
            "id": "nqi",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 760,
            "inputs": {},
            "opts": {
              "code": "json += \",\" + SUDO_Json.Key(\"events\") + \"[\";"
            }
          },
          {
            "id": "nqk",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 910,
            "inputs": {},
            "opts": {
              "code": "for (int i = 0; i < events.Count(); i++)\n{\n\tSUDO_Event e = events.Get(i);\n\n\tif (i > 0)\n\t{\n\t\tjson += \",\";\n\t}\n\n\tjson += \"{\";\n\tjson +=       SUDO_Json.Num(\"seq\", e.seq);\n\tjson += \",\" + SUDO_Json.Str(\"at\", e.at);\n\tjson += \",\" + SUDO_Json.Str(\"type\", e.type);\n\tjson += \",\" + SUDO_Json.Key(\"player\") + \"{\";\n\tjson +=       SUDO_Json.Str(\"steam64\", e.player.steam64);\n\tjson += \",\" + SUDO_Json.Str(\"beGuid\", e.player.beGuid);\n\tjson += \",\" + SUDO_Json.Str(\"name\", e.player.name);\n\tjson += \"}\";\n\tjson += \"}\";\n}"
            }
          },
          {
            "id": "nqm",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 1060,
            "inputs": {},
            "opts": {
              "code": "json += \"]\";"
            }
          },
          {
            "id": "nqo",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 1210,
            "inputs": {},
            "opts": {
              "code": "json += \"}\";"
            }
          },
          {
            "id": "nqr",
            "kind": "builtin",
            "ref": "bi.rawExpr",
            "x": 580,
            "y": 400,
            "inputs": {},
            "opts": {
