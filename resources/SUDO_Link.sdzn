            "opts": {
              "code": "for (int i = 0; i < length; i++)\n{\n\tstring ch = value.Get(i);\n\n\tif (ch == quote)\n\t{\n\t\tresult += backslash + quote;\n\t}\n\telse if (ch == backslash)\n\t{\n\t\tresult += backslash + backslash;\n\t}\n\telse if (ch == newline)\n\t{\n\t\tresult += backslash + \"n\";\n\t}\n\telse if (ch == carriage)\n\t{\n\t\tresult += backslash + \"r\";\n\t}\n\telse if (ch == tab)\n\t{\n\t\tresult += backslash + \"t\";\n\t}\n\telse\n\t{\n\t\tresult += ch;\n\t}\n}"
            }
