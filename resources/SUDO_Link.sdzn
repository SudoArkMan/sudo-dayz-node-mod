              "code": "Enqueue(item);"
            }
          },
          {
            "id": "ndv",
            "kind": "event",
            "ref": "fn.entry.fdu",
            "x": 40,
            "y": 8860,
            "inputs": {}
          },
          {
            "id": "ndw",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 8860,
            "inputs": {},
            "opts": {
              "code": "// Drop oldest rather than newest. During an outage the recent state of\n// the server is far more useful than the first minute of it, and an\n// unbounded queue would grow until the server ran out of memory.\nwhile (m_Queue.Count() >= SUDO_Const.MAX_SPOOL_EVENTS)\n{\n\tm_Queue.RemoveOrdered(0);\n\tm_Dropped++;\n}"
            }
          },
          {
            "id": "ndy",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 9010,
            "inputs": {},
            "opts": {
              "code": "m_Queue.Insert(item);"
            }
          },
          {
            "id": "ne1",
            "kind": "event",
            "ref": "fn.entry.fe0",
            "x": 40,
            "y": 9280,
            "inputs": {}
          },
          {
            "id": "ne2",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 9280,
            "inputs": {},
            "opts": {
              "code": "if (m_SendInFlight)\n{\n\treturn;\n}"
            }
          },
          {
            "id": "ne4",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 9430,
            "inputs": {},
            "opts": {
              "code": "if (m_Queue.Count() == 0)\n{\n\treturn;\n}"
            }
          },
          {
            "id": "ne6",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 9580,
            "inputs": {},
            "opts": {
              "code": "SUDO_EventsRequest request = new SUDO_EventsRequest();"
            }
          },
          {
            "id": "ne8",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 9730,
            "inputs": {},
            "opts": {
              "code": "request.batchId = string.Format(\"b_%1_%2\", m_TickCount, m_Queue.Count());"
            }
          },
          {
            "id": "nea",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 9880,
            "inputs": {},
            "opts": {
              "code": "request.droppedSinceLastBatch = m_Dropped;"
            }
          },
          {
            "id": "nec",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 10030,
            "inputs": {},
            "opts": {
              "code": "int limit = SUDO_Const.MAX_BATCH_EVENTS;"
            }
          },
          {
            "id": "nee",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 10180,
            "inputs": {},
            "opts": {
              "code": "if (m_Queue.Count() < limit)\n{\n\tlimit = m_Queue.Count();\n}"
            }
          },
          {
            "id": "neg",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 9280,
            "inputs": {},
            "opts": {
              "code": "int index = 0;"
            }
          },
          {
            "id": "nei",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 9430,
            "inputs": {},
            "opts": {
              "code": "while (index < limit)\n{\n\trequest.events.Insert(m_Queue.Get(index));\n\tindex++;\n}"
            }
          },
          {
            "id": "nek",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 9580,
            "inputs": {},
            "opts": {
              "code": "m_SendInFlight = true;"
            }
          },
          {
            "id": "nem",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 9730,
            "inputs": {},
            "opts": {
              "code": "m_Api.PostEvents(new SUDO_EventsCallback(), request.ToJson());"
            }
          },
          {
            "id": "nep",
            "kind": "event",
            "ref": "fn.entry.feo",
            "x": 40,
            "y": 10300,
            "inputs": {}
          },
          {
            "id": "neq",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 10300,
            "inputs": {},
            "opts": {
              "code": "m_SendInFlight = false;"
            }
          },
          {
            "id": "nes",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 10450,
            "inputs": {},
            "opts": {
              "code": "SUDO_SimpleResponse response = SUDO_SimpleResponse.FromJson(data);"
            }
          },
          {
            "id": "neu",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 10600,
            "inputs": {},
            "opts": {
              "code": "if (response.status == SUDO_Const.STATUS_AUTH_FAILED)\n{\n\t// Session expired. Re-link on the next tick using the API key; this\n\t// is routine, not an error.\n\tSUDO_Log.Debug(\"Session expired, relinking.\");\n\tm_Api.ClearSession();\n\treturn;\n}"
            }
          },
          {
            "id": "new",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 10750,
            "inputs": {},
            "opts": {
              "code": "if (response.status != SUDO_Const.STATUS_OK)\n{\n\tOnEventsFailure(response.error);\n\treturn;\n}"
            }
          },
          {
            "id": "ney",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 10900,
            "inputs": {},
            "opts": {
              "code": "// Only drop what the server confirmed. Clearing the whole queue here\n// would lose anything queued while the request was in flight.\nint sent = response.accepted + response.duplicates;"
            }
          },
          {
            "id": "nf0",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 11050,
            "inputs": {},
            "opts": {
              "code": "int index = 0;"
            }
          },
          {
            "id": "nf2",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 11200,
            "inputs": {},
            "opts": {
              "code": "while (index < sent && m_Queue.Count() > 0)\n{\n\tm_Queue.RemoveOrdered(0);\n\tindex++;\n}"
            }
          },
          {
            "id": "nf4",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 10300,
            "inputs": {},
            "opts": {
              "code": "m_Dropped = 0;"
            }
          },
          {
            "id": "nf6",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 10450,
            "inputs": {},
            "opts": {
              "code": "m_FailureStreak = 0;"
            }
          },
          {
            "id": "nf8",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 10600,
            "inputs": {},
            "opts": {
              "code": "SUDO_Log.Debug(string.Format(\"Sent %1 events, %2 remain.\", sent, m_Queue.Count()));"
            }
          },
          {
            "id": "nfb",
            "kind": "event",
