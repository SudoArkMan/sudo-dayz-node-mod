            "y": 2320,
            "inputs": {}
          },
          {
            "id": "n9y",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2320,
            "inputs": {},
            "opts": {
              "code": "m_Config = SUDO_ConfigLoader.Load();"
            }
          },
          {
            "id": "na0",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2470,
            "inputs": {},
            "opts": {
              "code": "if (!m_Config.IsConfigured())\n{\n\tSUDO_Log.Warn(\"Not configured. The link is idle; nothing will be sent.\");\n\treturn;\n}"
            }
          },
          {
            "id": "na2",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2620,
            "inputs": {},
            "opts": {
              "code": "m_FlushEvery = m_Config.eventFlushSeconds;"
            }
          },
          {
            "id": "na4",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2770,
            "inputs": {},
            "opts": {
              "code": "m_Api = new SUDO_Api(m_Config.baseUrl);"
            }
          },
          {
            "id": "na6",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 2920,
            "inputs": {},
            "opts": {
              "code": "if (!m_Api.IsReady())\n{\n\tSUDO_Log.Error(\"REST context unavailable. The link cannot start.\");\n\treturn;\n}"
            }
          },
          {
            "id": "na8",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 3070,
            "inputs": {},
            "opts": {
              "code": "if (!TryLink())\n{\n\tSUDO_Log.Warn(\"Initial link failed. Will retry automatically.\");\n}"
            }
          },
          {
            "id": "naa",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 3220,
            "inputs": {},
            "opts": {
              "code": "// CallLater takes a FUNCTION REFERENCE, not an object plus a method\n// name. The (this, \"Name\", ms, repeat) form is CallLaterByName, and\n// passing it here fails with \"Cannot convert SUDO_Manager to func\".\nGetGame().GetCallQueue(CALL_CATEGORY_SYSTEM).CallLater(\n\tthis.Tick, SUDO_Const.TICK_INTERVAL, true);"
            }
          },
          {
            "id": "nac",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 2320,
            "inputs": {},
            "opts": {
              "code": "m_Enabled = true;"
            }
          },
          {
            "id": "nae",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 2470,
            "inputs": {},
            "opts": {
              "code": "QueueServerEvent(SUDO_Const.EVENT_SERVER_START);"
            }
          },
          {
            "id": "nah",
            "kind": "event",
            "ref": "fn.entry.fag",
            "x": 40,
            "y": 3340,
            "inputs": {}
          },
          {
            "id": "nai",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 3340,
            "inputs": {},
            "opts": {
              "code": "GetGame().GetCallQueue(CALL_CATEGORY_SYSTEM).Remove(this.Tick);"
            }
          },
          {
            "id": "nak",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 3490,
            "inputs": {},
            "opts": {
              "code": "m_Enabled = false;"
            }
          },
          {
            "id": "nam",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 3640,
            "inputs": {},
            "opts": {
              "code": "if (m_Api)\n{\n\tm_Api.ClearSession();\n}"
            }
          },
          {
            "id": "nao",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 3790,
            "inputs": {},
            "opts": {
              "code": "SUDO_Log.Info(\"Link shut down.\");"
            }
          },
          {
            "id": "nar",
            "kind": "event",
            "ref": "fn.entry.faq",
            "x": 40,
            "y": 4060,
            "inputs": {}
          },
          {
            "id": "nas",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 4060,
            "inputs": {},
            "opts": {
              "code": "SUDO_LinkRequest request = new SUDO_LinkRequest();"
            }
          },
          {
            "id": "nau",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 4210,
            "inputs": {},
            "opts": {
              "code": "request.protocol = SUDO_Const.PROTOCOL_VERSION;"
            }
          },
          {
            "id": "naw",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 4360,
            "inputs": {},
            "opts": {
              "code": "request.apiKey = m_Config.apiKey;"
            }
          },
          {
            "id": "nay",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 4510,
            "inputs": {},
            "opts": {
              "code": "request.mod.version = SUDO_Const.MOD_VERSION;"
            }
          },
          {
            "id": "nb0",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 4660,
            "inputs": {},
            "opts": {
              "code": "request.server.maxPlayers = GetGame().ServerConfigGetInt(\"maxPlayers\");"
            }
          },
          {
            "id": "nb2",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 4810,
            "inputs": {},
            "opts": {
              "code": "request.server.mapName = GetGame().GetWorldName();"
            }
          },
          {
            "id": "nb4",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 300,
            "y": 4960,
            "inputs": {},
            "opts": {
              "code": "request.server.gameVersion = GetGameVersion();"
            }
          },
          {
            "id": "nb6",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 4060,
            "inputs": {},
            "opts": {
              "code": "request.server.instanceId = BuildInstanceId();"
            }
          },
          {
            "id": "nb8",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 4210,
            "inputs": {},
            "opts": {
              "code": "// The API rejected an early build with \"Protocol 0 is not supported\",\n// which it only returns for a well-formed JSON object that carries no\n// protocol field -- an empty body is reported as malformed instead. So\n// the payload is logged, with the key swapped out rather than trimmed,\n// because a truncated key still identifies the server.\nstring realKey = request.apiKey;"
            }
          },
          {
            "id": "nba",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 4360,
            "inputs": {},
            "opts": {
              "code": "request.apiKey = \"REDACTED\";"
            }
          },
          {
            "id": "nbc",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 4510,
            "inputs": {},
            "opts": {
              "code": "SUDO_Log.Info(\"Link payload: \" + request.ToJson());"
            }
          },
          {
            "id": "nbe",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 4660,
            "inputs": {},
            "opts": {
              "code": "request.apiKey = realKey;"
            }
          },
          {
            "id": "nbg",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 4810,
            "inputs": {},
            "opts": {
              "code": "string response = m_Api.LinkNow(request.ToJson());"
            }
          },
          {
            "id": "nbi",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 620,
            "y": 4960,
            "inputs": {},
            "opts": {
              "code": "if (response == \"\")\n{\n\tSUDO_Log.Warn(\"Link produced no response. The API may be unreachable.\");\n\treturn false;\n}"
            }
          },
          {
            "id": "nbk",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 940,
            "y": 4060,
            "inputs": {},
            "opts": {
              "code": "SUDO_LinkResponse parsed = SUDO_LinkResponse.FromJson(response);"
            }
          },
          {
            "id": "nbm",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 940,
            "y": 4210,
            "inputs": {},
            "opts": {
              "code": "if (parsed.status != SUDO_Const.STATUS_OK)\n{\n\tHandleLinkRejection(parsed);\n\treturn false;\n}"
            }
          },
          {
            "id": "nbo",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 940,
            "y": 4360,
            "inputs": {},
            "opts": {
              "code": "m_Api.SetSession(parsed.sessionToken);"
            }
          },
          {
            "id": "nbq",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 940,
            "y": 4510,
            "inputs": {},
            "opts": {
              "code": "// Intervals come from the server on every link, so pacing can be\n// changed centrally without shipping a mod update.\nif (parsed.heartbeatIntervalSeconds > 0)\n{\n\tm_HeartbeatEvery = parsed.heartbeatIntervalSeconds;\n}"
            }
          },
          {
            "id": "nbs",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 940,
            "y": 4660,
            "inputs": {},
            "opts": {
              "code": "if (parsed.pollIntervalSeconds > 0)\n{\n\tm_PollEvery = parsed.pollIntervalSeconds;\n}"
            }
          },
          {
            "id": "nbu",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 940,
            "y": 4810,
            "inputs": {},
            "opts": {
              "code": "m_FailureStreak = 0;"
            }
          },
          {
            "id": "nbw",
            "kind": "builtin",
            "ref": "bi.raw",
            "x": 940,
            "y": 4960,
            "inputs": {},
            "opts": {
              "code": "SUDO_Log.Info(\"Linked to SUDO. Server \" + parsed.serverId);"
            }
          },
          {
            "id": "nbz",
            "kind": "builtin",
            "ref": "bi.rawExpr",
            "x": 1220,
            "y": 4150,
            "inputs": {},
            "opts": {
              "code": "true"
            }
          },
          {
            "id": "nby",
            "kind": "builtin",
            "ref": "bi.return",
            "x": 1260,
