/* What the Properties tab in Explorer reads off the executable.
 *
 * Separate from resources/brand/appicon.rc on purpose. That file carries the
 * icon and never changes; this one is configured by CMake and changes with
 * every release, so keeping them apart means a version bump does not touch a
 * file that holds artwork. Windows reads both out of the same binary.
 *
 * FILEVERSION wants four comma separated numbers and nothing else, so the
 * pre-release suffix a semantic version can carry lives in the string block
 * instead, where it is allowed to be text. */

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* US English, Unicode. */
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@NODEMOD_VENDOR@"
            VALUE "FileDescription",  "@NODEMOD_DESCRIPTION@"
            VALUE "FileVersion",      "@NODEMOD_VERSION@"
            VALUE "InternalName",     "DAYZSUDONodeMod"
            VALUE "LegalCopyright",   "@NODEMOD_COPYRIGHT@"
            VALUE "OriginalFilename", "DAYZSUDONodeMod.exe"
            VALUE "ProductName",      "@NODEMOD_PRODUCT@"
            VALUE "ProductVersion",   "@NODEMOD_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
